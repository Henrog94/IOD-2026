{
  "openapi": "3.0.0",
  "info": {
    "title": "Module 5 Fake Store API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/products": {
      "get": {
        "summary": "Get all products",
        "responses": {
          "200": {
            "description": "Product list"
          }
        }
      }
    },
    "/api/products/category/{category}": {
      "get": {
        "summary": "Get products by category",
        "parameters": [
          {
            "name": "category",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Filtered product list"
          }
        }
      }
    },
    "/api/products/{id}": {
      "get": {
        "summary": "Get one product",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Product"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    }
  }
}