{
  "info": {
    "name": "Module09 MongoDB Blog",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    }
  ],
  "item": [
    {
      "name": "01 Create author",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/users",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"Author\",\n  \"email\": \"author@example.com\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Request succeeds',()=>pm.expect(pm.response.code).to.be.within(200,299));",
              "if(pm.response.code<300)pm.collectionVariables.set('authorId',pm.response.json()._id);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Create reader",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
